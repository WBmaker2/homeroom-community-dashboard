rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isLegacyHomeroomActivity(data) {
      return data.app == "homeroom-community-dashboard" && data.schemaVersion == 1;
    }

    function isOwnerAwareHomeroomActivity(data) {
      return data.app == "homeroom-community-dashboard" && data.schemaVersion == 2;
    }

    function isHomeroomActivity(data) {
      return isLegacyHomeroomActivity(data) || isOwnerAwareHomeroomActivity(data);
    }

    function isHomeroomActivityWrite(code) {
      return isOwnerAwareHomeroomActivity(request.resource.data)
        && request.resource.data.code == code
        && request.resource.data.teacherUid is string
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherId is string
        && request.resource.data.classId is string
        && request.resource.data.activityId is string
        && request.resource.data.payload is string;
    }

    function isHomeroomActivityOwnerByResource() {
      return request.auth != null && request.auth.uid == resource.data.teacherUid;
    }

    function isSubmissionCreate() {
      return isHomeroomActivity(request.resource.data)
        && request.resource.data.classId is string
        && request.resource.data.activityId is string
        && request.resource.data.studentId is string
        && request.resource.data.participationKey is string
        && request.resource.data.payload is string;
    }

    function isSubmissionForParentActivity(code) {
      let parent = get(/databases/$(database)/documents/homeroomPublicActivities/$(code));

      return isHomeroomActivity(parent.data)
        && request.resource.data.classId == parent.data.classId
        && request.resource.data.activityId == parent.data.activityId;
    }

    function isHomeroomActivityOwnerByCode(code) {
      let parent = get(/databases/$(database)/documents/homeroomPublicActivities/$(code));

      return parent.data.teacherUid is string && request.auth != null && request.auth.uid == parent.data.teacherUid;
    }

    function isExistingHomeroomActivity() {
      return isHomeroomActivity(resource.data);
    }

    match /homeroomPublicActivities/{code} {
      allow read: if isExistingHomeroomActivity();
      allow create: if request.auth != null && isHomeroomActivityWrite(code);
      allow update: if request.auth != null && isHomeroomActivityWrite(code)
        && request.resource.data.teacherUid == resource.data.teacherUid
        && request.resource.data.teacherUid == request.auth.uid;
      allow delete: if request.auth != null && isHomeroomActivityOwnerByResource();

      match /submissions/{submissionId} {
        allow read: if request.auth != null && isHomeroomActivityOwnerByCode(code);
        allow create: if isSubmissionCreate() && isSubmissionForParentActivity(code);
        allow update: if false;
        allow delete: if request.auth != null && isHomeroomActivityOwnerByCode(code);
      }
    }
  }
}
